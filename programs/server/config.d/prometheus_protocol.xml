<clickhouse>
  <prometheus>
    <port>9363</port>
    <handlers>
      <!-- Expose ClickHouse internal metrics for scraping -->
      <expose>
        <url>/metrics</url>
        <handler>
          <type>expose_metrics</type>
          <metrics>true</metrics>
          <asynchronous_metrics>true</asynchronous_metrics>
          <events>true</events>
          <errors>true</errors>
          <histograms>true</histograms>
          <dimensional_metrics>true</dimensional_metrics>
        </handler>
      </expose>
      
      <!-- Prometheus Remote Write endpoint -->
      <write>
        <url>/write</url>
        <handler>
          <type>remote_write</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </write>
      
      <!-- Prometheus Remote Read endpoint -->
      <read>
        <url>/read</url>
        <handler>
          <type>remote_read</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </read>
      
      <!-- PromQL Range Query endpoint -->
      <query_range>
        <url>/api/v1/query_range</url>
        <handler>
          <type>query_api</type>
          <database>otel</database>
          <table>metrics_v3</table>
          <lookback_delta>300</lookback_delta>
        </handler>
      </query_range>

      <!-- PromQL Instant Query endpoint -->
      <query>
        <url>/api/v1/query</url>
        <handler>
          <type>query_api</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </query>

      <!-- Series endpoint for Grafana label browser -->
      <series>
        <url>/api/v1/series</url>
        <handler>
          <type>query_api</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </series>

      <!-- Labels endpoint for Grafana autocomplete -->
      <labels>
        <url>/api/v1/labels</url>
        <handler>
          <type>query_api</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </labels>

      <!-- Label values endpoint for Grafana autocomplete -->
      <!-- Use regex: prefix to match any label name in the URL pattern -->
      <label_values>
        <url>regex:/api/v1/label/[^/]+/values</url>
        <handler>
          <type>query_api</type>
          <database>otel</database>
          <table>metrics_v3</table>
        </handler>
      </label_values>
    </handlers>
  </prometheus>
</clickhouse>
